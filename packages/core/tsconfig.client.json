{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/client.ts",
    "src/lib/image-processor.ts",
    "src/lib/media-upload.ts",
    "src/lib/nav-reorder.ts",
    "src/lib/compose-bridge.ts",
    "src/lib/settings-bridge.ts",
    "src/lib/post-form-bridge.ts",
    "src/lib/collections-reorder.ts",
    "src/types/sortablejs.d.ts",
    "src/ui/components/**/*.ts"
  ]
}
