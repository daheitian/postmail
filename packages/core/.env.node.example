# Node development defaults can now be omitted for DATABASE_URL and
# JANT_LOCAL_STORAGE_PATH. Uncomment them only if you want to override the
# built-in packages/core/.data locations.
#
# DATABASE_URL=file:./.data/jant.sqlite
# JANT_LOCAL_STORAGE_PATH=./.data/media

JANT_AUTH_SECRET=replace-with-a-long-random-secret
JANT_SITE_URL=http://127.0.0.1:3000
JANT_STORAGE_DRIVER=local
HOST=127.0.0.1
PORT=3000
