# Node development defaults can now be omitted for DATABASE_URL and
# JANT_LOCAL_STORAGE_PATH. Uncomment these only if you want to override the
# built-in packages/core/data layout.
#
# JANT_DATA_DIR=/absolute/path/to/jant-data
# DATABASE_URL=file:/absolute/path/to/jant-data/jant.sqlite
# JANT_LOCAL_STORAGE_PATH=/absolute/path/to/jant-data/media

JANT_AUTH_SECRET=replace-with-a-long-random-secret
JANT_SITE_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
