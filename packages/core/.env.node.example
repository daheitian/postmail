# Node development defaults can now be omitted for DATABASE_URL and
# LOCAL_STORAGE_PATH. Uncomment these only if you want to override the
# built-in packages/core/data layout.
#
# DATA_DIR=/absolute/path/to/jant-data
# DATABASE_URL=file:/absolute/path/to/jant-data/jant.sqlite
# Or use Postgres instead:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# LOCAL_STORAGE_PATH=/absolute/path/to/jant-data/media

AUTH_SECRET=replace-with-a-long-random-secret
SITE_ORIGIN=http://127.0.0.1:3000
# SITE_PATH_PREFIX=/blog
SITE_RESOLUTION_MODE=single-site
# Hosted control-plane integration (required in host-based mode except where noted)
# HOSTED_CONTROL_PLANE_BASE_URL=https://cloud-jant.localtest.me
# HOSTED_CONTROL_PLANE_INTERNAL_BASE_URL=http://127.0.0.1:3300
# HOSTED_CONTROL_PLANE_PROVIDER_NAME=jant.me
# HOSTED_CONTROL_PLANE_INTERNAL_TOKEN=replace-with-the-cloud-internal-admin-token
# INTERNAL_ADMIN_TOKEN=replace-with-the-cloud-admin-token
# HOSTED_CONTROL_PLANE_DOMAIN_CHECK_SECRET=replace-with-a-shared-32-plus-character-secret
# HOSTED_CONTROL_PLANE_SSO_SECRET=replace-with-a-shared-32-plus-character-secret
HOST=127.0.0.1
PORT=3000
