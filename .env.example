# Deployment environment example.
#
# Use this for Docker Compose or single-instance Node deployments.
# Repo automation such as demo rebuild/publish uses `.env.repo.example`
# instead of this file.

# Optional: override the published image tag, app port, or Docker host port.
# `PORT` changes the runtime port used by single-instance Node deployments and
# the container's internal app port under Compose. `HOST_PORT` changes the
# published host port for Compose.
# IMAGE=owenyoung/jant:latest
# PORT=3000
# HOST_PORT=3000

# Optional: pin the public origin Jant should use for canonical URLs, RSS,
# and sitemaps. When omitted, single-site requests use the current request
# origin.
# SITE_ORIGIN=https://your-jant.example
# Optional: mount Jant under a subpath, such as /blog.
# SITE_PATH_PREFIX=/blog

AUTH_SECRET=replace-with-a-long-random-secret

# Optional: Docker Compose defaults this to true because the recommended
# deployment path is behind Caddy, Nginx, or another reverse proxy that you
# control. Set it to false only if you expose the container directly.
# TRUST_PROXY=false
