# Optional: override the published image tag or local port mapping used by
# compose.yml.
# JANT_IMAGE=owenyoung/jant:latest
# JANT_PORT=3000

# Recommended: set the public origin you want Jant to use for canonical URLs,
# RSS, sitemaps, and subpath deployments.
# JANT_SITE_URL=https://your-jant.example

JANT_AUTH_SECRET=replace-with-a-long-random-secret

# Optional: Docker Compose defaults this to true because the recommended
# deployment path is behind Caddy, Nginx, or another reverse proxy that you
# control. Set it to false only if you expose the container directly.
# JANT_TRUST_PROXY=false
