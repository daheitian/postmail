{
  "name": "jant-content-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "jant migrate --local && wrangler dev",
    "deploy": "jant migrate --remote && jant assets prepare --output ./.jant/public-assets && wrangler deploy --assets ./.jant/public-assets",
    "reset-password": "jant reset-password",
    "export": "node scripts/export-content-lab.mjs"
  },
  "dependencies": {
    "@jant/core": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "catalog:"
  }
}
