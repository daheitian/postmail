# Repo automation environment example.
#
# Copy this to `.env.repo.local` when you run repo-level automation such as:
# - `mise run demo-source-export-canonical`
# - `mise run demo-rebuild`
# - `mise run deploy-demo`
# - `mise run deploy-demo-source`
#
# Site-specific API tokens still belong in:
# - `sites/demo/.env.local`
# - `sites/demo-source/.env.local`

CLOUDFLARE_API_TOKEN=replace-with-a-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
