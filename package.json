{
  "name": "jant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @jant/core dev",
    "build": "pnpm --filter @jant/core build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm changeset publish",
    "release:ci": "pnpm changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jant-me/jant.git"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "better-auth": "^1.4.18",
    "eslint": "^10.0.1",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "cn-font-split",
      "sharp"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "blurhash": "^2.0.5"
  }
}
